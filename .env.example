# FIIA — Exemplo de configuração de ambiente
# Copie este arquivo para .env e preencha valores reais localmente.
# Nunca versione .env com segredos reais.

# Ambiente: dev | staging | prod
FIIA_ENV=dev
FIIA_DEBUG=0
FIIA_OBSERVABILIDADE=1

# Obrigatória em staging/prod.
# Use uma chave longa, aleatória e exclusiva do ambiente.
FIIA_API_KEY=troque-por-uma-chave-local-com-mais-de-24-caracteres

# Hash SHA-256 da senha de acesso ao CLI.
# Gere com: python -c "import hashlib; print(hashlib.sha256(b'sua_senha').hexdigest())"
FIIA_SENHA_HASH=

# Opcional: chave para camada qualitativa/IA.
# Não coloque segredo real neste arquivo de exemplo.
GEMINI_API_KEY=

# Porta local exposta pelo Docker Compose.
FIIA_PORT=8080

# Diretório interno usado pelo container para dados persistentes.
FIIA_DATA_DIR=/app/data

# CORS permitido. Em produção, restrinja ao domínio real do frontend.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate limit operacional. Pode ficar desligado em dev/teste.
FIIA_RATE_LIMIT_ENABLED=0
FIIA_RATE_LIMIT_WINDOW_SECONDS=60
FIIA_RATE_LIMIT_DEFAULT_MAX=120
FIIA_RATE_LIMIT_SENSITIVE_MAX=30
FIIA_RATE_LIMIT_RADAR_MAX=3

# Validade temporal de dados.
PRECO_MAX_IDADE_HORAS=24
CVM_MAX_IDADE_MESES=3
